record raw-autotune.evidence.highlight-method-bench-20260809/1 : evidence {
    title "Seven synthetic tests passed. Harmonic BlueRamp measured normalized-linear RMSE 0.00286, final OKLab RMSE 0.00727, p99 boundary a/b 0.00382, p90 hue 1.12 degrees, and zero false-colour fraction. The harder blue-to-neutral fixture remained weak (linear RMSE 0.334, OKLab 0.0462, peak ratio 1.63), and raw-pyramid remained only a baseline; neither experiment is promoted."
    state verified
    result pass
    method command
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    command "cargo test synthetic::tests:: -- --nocapture"
    artifact "src/synthetic.rs"
    summary """
        Seven synthetic tests passed. Harmonic BlueRamp measured normalized-linear RMSE 0.00286, final OKLab RMSE 0.00727, p99 boundary a/b 0.00382, p90 hue 1.12 degrees, and zero false-colour fraction. The harder blue-to-neutral fixture remained weak (linear RMSE 0.334, OKLab 0.0462, peak ratio 1.63), and raw-pyramid remained only a baseline; neither experiment is promoted.
        """
}


record raw-autotune.evidence.profile-memory-safety-gate/1 : evidence {
    title "With 4.82 GiB MemAvailable, the planner capped an explicit request for eight concurrent images to one before decode. Unit tests also prove a zero-fit budget returns zero so plan refuses the run."
    state verified
    result pass
    method command
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    command "target/release/raw-autotune raw/raw_3rd_batch/20260729_114901.dng raw/raw_3rd_batch/_DSC1289.ARW --output .agent/scratch/default-identity --format jpeg --jobs 8"
    artifact "src/memory.rs"
    summary """
        With 4.82 GiB MemAvailable, the planner capped an explicit request for eight concurrent images to one before decode. Unit tests also prove a zero-fit budget returns zero so plan refuses the run.
        """
}


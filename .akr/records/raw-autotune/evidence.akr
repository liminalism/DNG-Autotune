record raw-autotune.evidence.camsdd-gate-2-policy-recall-20260826/1 : evidence {
    title "Gate 2 policy recall: Backlight 82.5% top-1 / 97.5% top-3, inconclusive as authored"
    state verified
    result inconclusive
    method command
    observed_at git:3ec22b0e0f15001166237dc8bf36de4e9edcc9a1
    command ".venv-train/bin/python tools/scene_models/train_camsdd.py --stage eval --run tools/scene_models/runs/ft0 --split both"
    artifact "tools/scene_models/runs/ft0/eval_both.json"
    summary """
        Gate 2 as authored (top-1 recall >= 90 percent per policy class over val+test, n=40 each) is not met by Backlight: top-1 recall 82.5 percent, inside the inspect band (80-90). Night_shot, Candle_light and Indoor are at 100 percent, Macro at 90. The confusion is the pre-registered one: 4 of 7 Backlight misses go to Sunset_Sunrise; Macro misses go to Food/Flower (close-up-adjacent). Measured at top-3, which is what the plan's inference-time mapping consumes, Backlight is 97.5 percent and every other policy class 100 percent. Disposition left open: either amend the check to the top-k mapping metric, or pursue targeted top-1 fixes (class re-weighting; phase-3c domain adaptation may also move it). The plan's fusion layer independently corroborates backlit with the centre/surround EV split.
        """
}

record raw-autotune.evidence.camsdd-gate-2-topk-20260826/1 : evidence {

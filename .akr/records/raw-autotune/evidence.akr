record raw-autotune.evidence.slice-4-confidence-plumbing-verify/1 : evidence {
    title "Per-CFA c_i=smoothstep(T0,T1) preserved through hotpixels, demosaiced via propagate_mosaic_confidence, exposed to highlight::reconstruct_with_confidence_and_uncertainty; determinism under --jobs 8 preserved, normalize_does_not_mutate_the_raw_image passes."
    state verified
    result pass
    method command
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    command "cargo test --release rescale hotpixels && src/color.rs propagate_mosaic_confidence via demosaic alongside samples"

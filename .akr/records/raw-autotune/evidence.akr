    result pass
    method command
    observed_at git:2ce6bf6210815faf878df448047f7621cb9903cd
    command "./target/release/raw-autotune raw/raw_old/files_2026-07-27_16-48-01/expertraw.dng --dry-run --semantic --summary S.json"
    summary """
        A default --semantic run with the face detector gated off still produces the full observational sidecar: models lists cityscapes-segmenter alone, inference_errors is absent, and all nine RegionKind entries — face, person, sky, vegetation, water, snow_or_sand, building_or_interior, text_or_document, salient_foreground — are still present in regions. So gating the detector removed a model load, not a field.

        cargo test --release passes in full (362) with the gate in place, and clippy and fmt are clean.
        """
}

record raw-autotune.evidence.semantic-sky-camera-grade/1 : evidence {
    title "Camera-paired sky policy grade"
    state superseded
    result pass
    method command
    observed_at git:339a2161f88921038a7e1fb01cdacd3113d86372
    command "python3 tools/grade_sky.py .agent/scratch/sky-ablation/off .agent/scratch/sky-ablation/on --reference raw/jpeg --json .agent/scratch/sky-ablation/camera-grade.json --per-frame"
    artifact ".agent/scratch/sky-ablation/camera-grade.json"
    summary """
        Median sky error versus paired camera JPEG moved from -0.42 EV off to -0.43 EV on while ground stayed -0.05 EV; sky green deficit moved 22.9% to 23.0%. The mask is useful, but this compression direction does not merit default promotion.
        """
}


record raw-autotune.papercut.forwarding-six-full-resolution-diagnostic-pngs/1 : papercut {
    title "Forwarding six full-resolution diagnostic PNGs through the image viewer…"
    state verified
    statement """
        Forwarding six full-resolution diagnostic PNGs through the image viewer exceeded the IPC frame limit; making a downscaled montage first is required, but the limit is only reported after all images are loaded.
        """

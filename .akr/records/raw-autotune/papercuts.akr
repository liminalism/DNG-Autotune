record raw-autotune.papercut.a-release-build-invocation-returned-without/1 : papercut {
    title "A release build invocation returned without Cargo's Finished line and…"
    state verified
    statement """
        A release build invocation returned without Cargo's Finished line and left the previous binary in place, so the first batch gate rejected the new --lens-correction flag. Retrying the build explicitly and verifying --help before the batch; tooling should surface the subprocess exit status when output is handed off through a cell.
        """
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    author "codex"
    created_at 2026-08-08
}

record raw-autotune.papercut.a-targeted-cargo-test-invocation-with-two-exact/1 : papercut {
    title "A targeted `cargo test` invocation with two exact test filters fails…"
    state verified
    statement """
        A targeted `cargo test` invocation with two exact test filters fails because Cargo accepts only one positional filter; filtering on the containing `tone::tests` module is the reliable way to run both.
        """
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    about "cargo"
    author "codex"
    created_at 2026-08-08
}

record raw-autotune.papercut.a-two-frame-lens-correction-profile-exact/1 : papercut {
    title "A two-frame --lens-correction profile-exact render was killed after…"
    state verified
    statement """
        A two-frame --lens-correction profile-exact render was killed after decode: the job-memory planner does not yet account for simultaneous RGB and clip-confidence resampling buffers. Retrying the diagnostic at --jobs 1 avoids the peak; the planner should budget profiled lens correction before this mode can graduate from opt-in.
        """
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    author "codex"
    created_at 2026-08-08
}


record raw-autotune.papercut.state-only-revise-on-sealed-work-head-l002/1 : papercut {
    title "akr revise --state on a sealed work head aborts with a false AKR-L002"
    state superseded
    statement "akr revise raw-autotune.work.train-camsdd-scene-classifier --state completed aborted with AKR-C031/AKR-L002 claiming 3 revisions are unsuperseded, while akr get --history and the ledger file showed rev 1 and 2 superseded and rev 3 the sole active head. The same transition succeeded through revise --from with a full canonical body carrying state completed. The state-only path seems to stage rev 4 without retiring rev 3."
    observed_at git:7d33518c87c0cfc1836e4c08dcfb2563cefe0f4b
    about "akr 0.3.3 revise --state"
}

record raw-autotune.papercut.state-only-revise-on-sealed-work-head-l002/2 : papercut {
    title "akr revise --state on a sealed work head aborts with a false AKR-L002"
    state verified
    statement "akr revise --state completed on raw-autotune.work.train-camsdd-scene-classifier failed with AKR-L002 claiming 3 revisions are unsuperseded although states were consistent (1-3 superseded, head proposed/active). Root cause: revisions 2 and 3 had been written without supersedes back-edges, so edge-based head resolution goes ambiguous the moment every revision is state-terminal. The failure only surfaces on the transition to a terminal state, and the message points at revision count rather than the missing edges, which cost a debugging detour. Fix that worked: give the new head supersedes [ @key/1, @key/2, @key/3 ]. A friendlier diagnostic would name the edge-less revisions."
    observed_at git:7d33518c87c0cfc1836e4c08dcfb2563cefe0f4b
    about "akr 0.3.3 revise --state"
    supersedes [ @raw-autotune.papercut.state-only-revise-on-sealed-work-head-l002/1 ]
}

record raw-autotune.papercut.the-agents-protocol-names-knowledge-context-as/1 : papercut {
    title "The AGENTS protocol names knowledge.context as the first-step command,…"

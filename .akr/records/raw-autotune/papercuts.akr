record raw-autotune.papercut.grade-sky-py-reported-zero-pairs-on-a-normal/1 : papercut {
    title "`grade_sky.py` reported zero pairs on a normal recursive batch output…"
    state verified
    statement """
        `grade_sky.py` reported zero pairs on a normal recursive batch output because rendered files were nested under the input directory name; the tool does not recurse or point the user to the discovered child directory.
        """
    observed_at git:ff74d3b248f65ea98bde93578a3b95c80a647181
    author "codex"
    created_at 2026-08-08
}


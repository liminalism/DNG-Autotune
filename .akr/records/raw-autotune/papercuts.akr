record raw-autotune.papercut.knowledge-search-and-knowledge-start-via-the/1 : papercut {
    title "knowledge.search and knowledge.start via the akr MCP tool repeatedly…"
    state verified
    statement """
        knowledge.search and knowledge.start via the akr MCP tool repeatedly failed with FTS5 errors (e.g. "fts5: syntax error near ','" on a comma-containing query, and "no such column: default" on the query 'HDR slice 6 non-default feature'). Queries with bare punctuation or reserved-looking words need escaping/quoting, or the tool should sanitise them. Fell back to grepping .akr/records directly.
        """

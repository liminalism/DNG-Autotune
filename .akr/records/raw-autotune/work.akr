            """
    }
}

record raw-autotune.work.harmonic-highlight-experiment/1 : work {
    title "Harmonic pre-demosaic highlight experiment"
    state active
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "THIRD_PARTY.md",
        path "src/cli.rs",
        path "src/color.rs",
        path "src/memory.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs"
    ]
    intent """
        Add and validate an opt-in CLI-only clean-room harmonic highlight
        experiment on the normalized Bayer mosaic. Use connected clipped
        regions, local one/two-guide affine colour fits with quality gates,
        clipping-aware pyramid initialization, anisotropic obstacle-constrained
        transport, verified sensor-knee inversion, and a separate fully clipped
        luminance dome. Use pure-Rust faer f64 sparse Cholesky for bounded
        systems and deterministic projected relaxation for larger or failed
        systems. Keep measured sites and floors invariant and keep `current` as
        the unattended default. The work remains active pending real-frame
        corpus gates, measured 24 MP RSS, and further coloured-highlight
        abstention work.
        """
    depends_on [ @raw-autotune.work.slice-2-synthetic-ramp-suite-and-ablation/1 ]
}

record raw-autotune.work.highlight-boundary-fringe-diagnosis/1 : work {
    title "Diagnose and remove the residual highlight-boundary colour fringe"
    state completed
    scope [
        path "src/color.rs",
        path "src/highlight.rs",
        path "src/synthetic.rs",
        path "src/tone.rs",
        path "tools/"
    ]
    intent """
        Determine whether the lavender/purple contour remaining on `_DSC1283` and `_DSC1289` is recorded lens/demosaic colour or the low-confidence edge of highlight reconstruction. Add only the diagnostics needed to identify it, then implement a continuous correction if the evidence supports one. Preserve the exact `--highlight-reconstruction 0` contract and avoid semantic sky detection or global bright-pixel desaturation.
        """
    acceptance {
        check origin-is-measured {
            statement """
                The visible fringe is localized against raw-domain reconstruction confidence and compared across reconstruction-off and multiple demosaic controls.
                """
            method observation
            verified_by [ @raw-autotune.evidence.highlight-fringe-origin-controls/1 ]
        }
        check regression-gate {
            statement """
                Formatting, library/tests lint, and the project test suite pass; reconstruction strength zero remains the compatibility path.
                """
            method command
            verified_by [ @raw-autotune.evidence.highlight-white-path-regression-gate/1 ]
        }
        check target-frames-improve {
            statement """
                A repeatable image-space measurement shows the boundary fringe decreases on `_DSC1283` and `_DSC1289` without restoring the dark taupe inversion.
                """
            method command
            verified_by [ @raw-autotune.evidence.highlight-white-path-target-grade/1 ]
        }
    }
}


akr 0.1
project raw-autotune

record raw-autotune.work.compression-aware-highlight-ratio-promotion/1 : work {
    title "Promote compression-aware highlight ratios without white blowout"
    state superseded
    scope [
        path "CHANGELOG.md",
        path "README.md",
        path "src/api.rs",
        path "src/cli.rs",
        path "src/highlight.rs",
        path "src/types.rs"
    ]
    intent """
        Promote the existing compression-aware color/luminance-ratio exponent of 0.6 into the unattended archive profile, while keeping exponent 1.0 as the explicit legacy/no-op control and keeping exact external lens profiles opt-in.

        Re-evaluate the earlier white-blowout rejection after the intervening near-white anchor, peak-preserving highlight path, and renderer fixes. Gate the promotion on the 58-file third-batch sky cohort and the documented paired-camera corpus: broad sky green deficit must improve without moving ground exposure, hard clipping must not regress, near-white share must not increase, paired saturation must remain inside the documented daylight range, and hue error must remain materially neutral.

        Advance the versioned unattended profile because this deliberately changes default rendered pixels in the CLI and in-memory API. Record the chosen parameter in the existing report field; do not change the report schema.
        """
    acceptance {
        check implementation-regression-gate {
            statement """
                The automatic CLI and in-memory defaults agree on archive-auto-v3, exponent 1.0 remains an explicit no-op control, focused/full tests and clippy pass, repeated jobs-8 renders are byte-identical, and AKR build/check pass.
                """
            method command
            verified_by [
                @raw-autotune.evidence.compression-highlight-regression-gate-20260810/1
            ]
        }
        check paired-camera-colour-gate {
            statement """
                On the documented paired-camera render gate, saturation remains inside the accepted daylight range and aggregate hue error remains materially neutral while near-white share falls.
                """
            method command
            verified_by [ @raw-autotune.evidence.compression-highlight-paired-gate-20260810/1 ]
        }
        check sky-chroma-white-gate {
            statement """
                On raw/raw_3rd_batch, exponent 0.6 reduces the measured sky green deficit without moving ground exposure and does not increase hard clipping or the maximum near-white share.
                """
            method command
            verified_by [ @raw-autotune.evidence.compression-highlight-sky-gate-20260810/1 ]
        }
    }
    author "GitHub Uploader"
}


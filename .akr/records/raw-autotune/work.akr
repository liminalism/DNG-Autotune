record raw-autotune.work.semantic-sky-highlight-ablation/1 : work {
    title "Ablate mask-resolved sky highlight luma policy"
    state superseded
    scope [
        path "src/api.rs",
        path "src/cli.rs",
        path "src/pipeline.rs",
        path "src/scene.rs",
        path "src/types.rs",
        path "tests/**",
        path "tools/**"
    ]
    intent """
        Add an explicit experimental control that resamples the per-pixel semantic sky confidence mask from its letterboxed 512 proxy into scene-linear image coordinates, intersects it with measured highlight/reconstruction evidence, and applies only a small bounded luminance compression while preserving RGB chromaticity. Keep semantic inference and the adjustment opt-in; feature-off output must remain byte-identical. Evaluate the four validated clipped-sky files against feature-off output with spatial metrics and visual inspection before any default or public policy promotion.
        """
    acceptance {
        check bounded-luma-only {
            statement """
                The experiment changes only qualifying bright sky pixels, preserves per-pixel RGB chromaticity within numerical tolerance, is deterministic, and obeys its configured luminance cap.
                """
            method command
        }
        check feature-off-identity {
            statement """
                Semantic disabled and experimental strength zero preserve the established output byte-for-byte on representative sky input.
                """
            method command
        }
        check four-frame-ablation {
            statement """
                Feature-off versus mask-resolved outputs for _DSC1272, _DSC1283, _DSC1288, and _DSC1289 are measured and visually reviewed, with a recorded promote/reject/refine conclusion.
                """
            method observation
        }
        check mask-resolved {
            statement """
                Tests demonstrate that sky confidence is sampled per image pixel with correct letterbox inversion, bilinear bounds, confidence gating, and no padding spill.
                """
            method command
        }
        check no-default-promotion {
            statement """
                The unattended default remains unchanged and the sidecar explicitly identifies any experimental semantic policy adjustment.
                """
            method command
        }
    }
    after [ @raw-autotune.work.scene-evidence-corpus-policy/2 ]
    depends_on [ @raw-autotune.work.scene-perception-infra/1 ]
    derived_from [ @raw-autotune.assessment.scene-evidence-usefulness/2 ]
}


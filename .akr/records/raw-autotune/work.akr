record raw-autotune.work.scene-model-pack/1 : work {
    title "Scene-model pack: fetch, prepare, remap"
    state superseded
    scope [ path "models/**", path "tools/scene_models/**" ]
    intent """
        Download pinned YuNet FP32, reparameterized MobileOne-S0, and two or three lightweight segmenter candidates. Rewrite each into a lege-gpu-compatible prepared ONNX graph: FLOAT32, NCHW, input renamed to scene_image, Conv+BN fused, no QuantizeLinear/TopK/NMS, static or stamped 512x512. Keep the segmenter that both prepares and remaps onto the most RegionMasks classes. Commit manifest, remaps, and license notes; do not commit weight blobs.
        """
    acceptance {
        check mobileone-prepares {
            statement """
                A reparameterized MobileOne-S0 prepared graph exists and is recorded as a backbone, not as SceneScores.
                """
            method observation
        }
        check no-weight-blobs-committed {
            statement """
                models/artifacts/ is gitignored; only manifest.json, remaps, and LICENSE-NOTES.md are tracked.
                """
            method command
            command "git check-ignore -q models/artifacts"
        }
        check segmenter-prepares {
            statement """
                A prepared segmenter artifact exists with a committed class remap covering at least person plus one of sky, vegetation, or building.
                """
            method observation
        }
        check yunet-prepares {
            statement """
                A prepared YuNet FP32 artifact exists, its SHA-256 is pinned in models/manifest.json, and inspect reports only ops lege-gpu accepts.
                """
            method command
            command "python3 tools/scene_models/inspect.py models/artifacts/yunet.prepared.onnx"
        }
    }
    implements [ @raw-autotune.decision.scene-perception-uses-lege-gpu-prepared-graphs ]
}


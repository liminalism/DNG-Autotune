record raw-autotune.work.profiled-purple-sky-experiment/1 : work {
    title "Profiled purple-sky and compression-ratio experiment"
    state completed
    scope [
        path "CHANGELOG.md",
        path "Cargo.toml",
        path "README.md",
        path "THIRD_PARTY.md",
        path "src/cli.rs",

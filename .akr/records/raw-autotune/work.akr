record raw-autotune.work.highlight-boundary-fringe-diagnosis/1 : work {
    title "Diagnose and remove the residual highlight-boundary colour fringe"
    state completed
    scope [
        path "src/color.rs",
        path "src/highlight.rs",
        path "src/synthetic.rs",
        path "src/tone.rs",
        path "tools/"
    ]
    intent """
        Determine whether the lavender/purple contour remaining on `_DSC1283` and `_DSC1289` is recorded lens/demosaic colour or the low-confidence edge of highlight reconstruction. Add only the diagnostics needed to identify it, then implement a continuous correction if the evidence supports one. Preserve the exact `--highlight-reconstruction 0` contract and avoid semantic sky detection or global bright-pixel desaturation.
        """
    acceptance {
        check origin-is-measured {
            statement """
                The visible fringe is localized against raw-domain reconstruction confidence and compared across reconstruction-off and multiple demosaic controls.
                """
            method observation
            verified_by [
                @raw-autotune.evidence.highlight-fringe-origin-controls/1,
                @raw-autotune.evidence.highlight-fringe-origin-controls/2
            ]
        }
        check regression-gate {
            statement """
                Formatting, library/tests lint, and the project test suite pass; reconstruction strength zero remains the compatibility path.
                """
            method command
            verified_by [
                @raw-autotune.evidence.highlight-white-path-regression-gate/1,
                @raw-autotune.evidence.highlight-white-path-regression-gate/2
            ]
        }
        check target-frames-improve {
            statement """
                A repeatable image-space measurement shows the boundary fringe decreases on `_DSC1283` and `_DSC1289` without restoring the dark taupe inversion.
                """
            method command
            verified_by [
                @raw-autotune.evidence.highlight-white-path-target-grade/1,
                @raw-autotune.evidence.highlight-white-path-target-grade/2
            ]
        }
    }
}


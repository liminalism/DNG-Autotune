record raw-autotune.work.slice-5-joint-raw-log-chromaticity/1 : work {
    title "Slice 5 — Integrate joint raw-domain log-chromaticity into harmonic reconstruction"
    state completed
    scope [
        path "src/color.rs",
        path "src/highlight.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs",
        path "src/tone.rs",
        path "tools/**"
    ]
    intent """
        Replace the harmonic path's one-channel/two-channel clip-state estimator handoff with one continuous chromaticity estimator across the entire clipped Bayer component. Keep the existing harmonic and pyramid reconstruction responsible for luminance and spatial detail, but jointly solve chromaticity in Bayer-quad space from continuous channel confidence and all surviving pairwise log ratios: log(R/G), log(B/G), and log(R/B), with trust t_c=(1-c_c)^2. Use edge-aware component coupling, a weak harmonic initialization/prior only, and no frame-average chromaticity.

        Recompose a white-balanced q=[exp(u),1,exp(v)] with a trusted-channel scalar intensity fit, enforce sensor floors, and apply only positive continuous per-site corrections weighted by the channel confidence and reconstruction strength. Confidence zero and strength zero must be exact no-ops; measured channels remain lower bounds and are never darkened. Remove binary valid/confidence-0.5 behavior from final authority, including keep_unfitted_partial_cells() overwrites and apply_prediction() skips. Disable transport_spatial_chromaticity() for Harmonic production output; retain it only as an internal ablation because a second post-demosaic chroma model must not own the two-channel side alone. A smooth neutral fallback is permitted only deep inside fully clipped components with no local or boundary evidence.

        Add a synthetic _DSC1289-like smooth Bayer-quad fixture with white balance approximately [2.3632812, 1.0, 1.8085938], broad one-/two-channel clipped cohorts, and optional sky/foliage occlusion. Report 0↔1, 1↔2, and 2↔3 transitions separately. The critical promotion gate is 1↔2 boundary OKLab chroma p90 divided by nearby same-state p90 <= 1.25 at highlight-post and after-tone-curve, alongside no-darkening, zero-confidence/zero-strength, hue/occluder, luminance/peak-recovery, corpus, memory, and jobs-1/jobs-8 determinism gates. Do not weaken the tone shoulder or extend post-demosaic transport as the fix. This is a proposed, unverified design and must not be promoted until implementation, synthetic measurements, archived _DSC1289 comparison, and regression gates pass.
        """
    acceptance {
        check critical-one-to-two-boundary-gate {
            statement """
                The synthetic and archived-frame gates report clip-state transitions separately and keep 1↔2 boundary OKLab chroma p90 divided by nearby same-state p90 at or below 1.25 after highlight-post and after the tone curve.
                """
            method command
            verified_by [ @raw-autotune.evidence.slice-5-critical-boundary-gate-20260816/1 ]
        }
        check joint-estimator-owns-clip-state-chromaticity {
            statement """
                Harmonic production reconstruction uses one continuous confidence-weighted joint log-chromaticity field across one- and two-channel clipped Bayer components, with trusted-channel scalar intensity recovery and no second production chroma estimator.
                """
            method command
            verified_by [
                @raw-autotune.evidence.slice-5-joint-estimator-production-ownership-20260816/1
            ]
        }
        check raw-reconstruction-regression-gates {
            statement """
                The implementation preserves no-darkening, zero-confidence/zero-strength exact no-ops, hue/occluder protection, luminance and peak recovery, corpus, memory, and jobs-1/jobs-8 determinism gates.
                """
            method command
            verified_by [
                @raw-autotune.evidence.slice-5-release-corpus-memory-determinism-20260816/1
            ]
        }
    }
    depends_on [ @raw-autotune.work.raw-pyramid-highlight-baseline/1 ]
    derived_from [ @raw-autotune.evidence.sky-stage-attribution-20260816-r2/1 ]
    implements [ @raw-autotune.requirement.slice-5-continuous-log-chromaticity/1 ]
}


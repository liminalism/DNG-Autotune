record raw-autotune.work.scene-perception-default-lege-gpu/1 : work {
    title "Default lege-gpu scene inference with Linux RTX 4060"
    state completed
    intent """
        Make lege-gpu an unconditional dependency of raw-autotune, remove compile-time semantic gates, expose a generic GPU execution method from lege-gpu's prepared ONNX session, and prefer the shared hardware adapter for scene inference. Verify the Linux RTX 4060 runs both prepared scene graphs without CPU fallback and that semantic collection remains pixel-identical to the feature-off render.
        """
    acceptance {
        check default-build {
            statement """
                Default and --no-default-features release builds include the scene integration.
                """
            method command
            command "cargo check --all-targets --release && cargo check --all-targets --release --no-default-features"
            verified_by [ @raw-autotune.evidence.default-lege-gpu-build-20260813/1 ]
        }
        check linux-4060 {
            statement """
                A real RAW semantic run on Linux records the RTX 4060 Vulkan backend for both models with no fallback.
                """
            method command
            command "WGPU_ADAPTER_NAME=4060 WGPU_REQUIRE_REAL_GPU=1 cargo run --release -- raw/raw_3rd_batch/_DSC1289.ARW --output .agent/scratch/scene-gpu-4060-20260813 --format png --sidecar --no-summary --overwrite --jobs 1 --semantic"
            verified_by [ @raw-autotune.evidence.scene-rtx4060-vulkan-20260813/1 ]
        }
        check observational-only {
            statement """
                The RTX 4060 semantic run produces the same PNG bytes as the feature-off baseline.
                """
            method command
            command "sha256sum .agent/scratch/scene-infra-gate-20260813/off/_DSC1289_auto.png .agent/scratch/scene-gpu-4060-20260813/_DSC1289_auto.png"
            verified_by [ @raw-autotune.evidence.scene-rtx4060-pixel-identity-20260813/1 ]
        }
    }
    implements [ @raw-autotune.decision.scene-perception-uses-lege-gpu-prepared-graphs/1 ]
}

record raw-autotune.work.scene-perception-infra/1 : work {
    title "Scene perception infrastructure, no render change"
    state completed
    scope [
        path "src/api.rs",
        path "src/cli.rs",
        path "src/pipeline.rs",
        path "src/preview.rs",
        path "src/scene.rs",
        path "src/types.rs"
    ]
    intent """
        Extract one processing core shared by CLI and API. Add SemanticProxy, SceneEvidence, RegionMasks, RegionStats, and model provenance. Build a fixed 512-letterboxed neutral sRGB proxy after chroma denoise and before local WB. Split preview RGB decode from exposure-oracle eligibility. Run optional lege-gpu inference behind --semantic; dump proxy and mask overlays. Inference must not change JPEG/TIFF/PNG bytes.
        """
    note """
        Implemented the observational scene-perception core shared by CLI and API: fixed 512-letterboxed neutral sRGB RAW proxy after chroma denoise and before local WB; split embedded preview RGB decode from exposure-oracle eligibility; optional lege-gpu CPU inference for the prepared Cityscapes segmenter and YuNet behind --semantic; model SHA-256/preprocessing provenance, raw class scores, RegionMasks/RegionStats/SceneEvidence, and proxy/mask stage dumps. Semantic evidence remains structurally unable to feed analysis or rendering.
        """
    acceptance {
        check feature-off-byte-identical {
            statement """
                With the semantic feature off or --semantic unset, output matches a pre-change dry-run summary field-for-field except elapsed_ms.
                """
            method command
            command "cargo test --release"
            verified_by [ @raw-autotune.evidence.scene-perception-validation-20260813/1 ]
        }
        check inference-does-not-render {
            statement """
                Enabling --semantic records SceneEvidence in the sidecar and does not move output pixels relative to the same run with inference skipped.
                """
            method observation
            verified_by [
                @raw-autotune.evidence.semantic-inference-is-observational-20260813/1
            ]
        }
        check preview-split {
            statement """
                Exposure-oracle eligibility is unchanged; a 256x191 preview can be semantically eligible without becoming an exposure oracle.
                """
            method observation
            verified_by [ @raw-autotune.evidence.semantic-preview-split-20260813/1 ]
        }
    }
    after [ @raw-autotune.work.lege-gpu-onnx-session, @raw-autotune.work.scene-model-pack ]
    implements [ @raw-autotune.decision.scene-perception-uses-lege-gpu-prepared-graphs ]
}

record raw-autotune.work.semantic-sky-chromatic-ablation/1 : work {
    title "Evaluate mask-gated sky chromatic correction"
    state superseded
    scope [
        path "src/api.rs",
        path "src/cli.rs",
        path "src/pipeline.rs",
        path "src/scene.rs",
        path "src/types.rs",
        path "tests/**",
        path "tools/**"
    ]
    intent """
        Determine whether the dense sky mask can safely gate a sky-only chromatic correction. Do not infer a white point from the semantic label or neutralize natural blue. Any opt-in experiment must be driven by measured reconstruction uncertainty or the known bright-sky magenta/green-deficit signature, remain bounded and spatially feathered, preserve luminance/global exposure, and be evaluated against paired camera JPEGs before promotion.
        """
    acceptance {
        check bounded-colour-only {
            statement """
                Any implemented experiment is deterministic, bounded, spatially weighted, preserves luminance within tolerance, and is zero/off by default.
                """
            method command
            command "cargo test -q --lib scene::tests"
        }
        check camera-paired-ablation {
            statement """
                Candidate frames are graded against paired camera JPEGs for sky green deficit, purple fraction, brightness, and ground isolation.
                """
            method observation
        }
        check no-concealment {
            statement """
                No default promotion conceals the known highlight-reconstruction discontinuity; a negative or inconclusive experiment remains diagnostic-only.
                """
            method observation
        }
        check not-semantic-whitepoint {
            statement """
                The semantic sky label is used only as a spatial gate; correction direction comes from measured colour evidence, not an assumed neutral sky.
                """
            method observation
        }
    }
    depends_on [ @raw-autotune.work.semantic-sky-highlight-ablation/2 ]
    derived_from [ @raw-autotune.work.slice-8-local-tone-sky-ground-hdr-evaluation/2 ]
}


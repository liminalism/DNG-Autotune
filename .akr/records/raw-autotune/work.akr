        path "src/pipeline.rs",
        path "src/tone.rs",
        path "src/types.rs",
        path "tests/profile_lens.rs"
    ]
    intent """
        Use the supplied research to separate residual lavender/purple skies into optical edge fringing and broad tone-compression colour drift. Add an explicitly selected, exact-only Lensfun distortion/TCA experiment and a compression-aware colour-ratio experiment without changing their defaults. Evaluate both on target frames and the full third batch, promote neither when the clipping gate fails, and make the added full-resolution resampling incapable of bypassing conservative batch-memory limits even when --jobs is numeric.
        """
    acceptance {
        check exact-profile-is-bounded {
            statement """
                The external lens path requires one canonical camera/lens match, applies distortion and TCA without fuzzy selection or vignetting, aligns external-profile RGB and raw clip-confidence coordinates, and remains opt-in.
                """
            method command
            verified_by [
                @raw-autotune.evidence.exact-lens-profile-gate/1,
                @raw-autotune.evidence.exact-lens-profile-gate/2
            ]
        }
        check memory-fails-safe {
            statement """
                Exact-profile memory is included in planning, numeric --jobs is only an upper bound, and a batch is refused before decode when the reserved share of available memory cannot fit one frame.
                """
            method command
            verified_by [
                @raw-autotune.evidence.profile-memory-safety-gate/1,
                @raw-autotune.evidence.profile-memory-safety-gate/2
            ]
        }
        check regression-gate {
            statement """
                Formatting, tests, lint, exact-profile integration, and AKR validation pass, while the embedded default retains its historical confidence-map behavior.
                """
            method command
            verified_by [
                @raw-autotune.evidence.profile-experiment-regression-gate/1,
                @raw-autotune.evidence.profile-experiment-regression-gate/2
            ]
        }
        check research-experiment-is-gated {
            statement """
                Compression-aware colour ratios preserve mapped luminance and the default is an exact no-op; target and full-batch measurements decide whether the experiment is promoted.
                """
            method command
            verified_by [
                @raw-autotune.evidence.compression-ratio-batch-gate/1,
                @raw-autotune.evidence.compression-ratio-batch-gate/2
            ]
        }
    }
}


record raw-autotune.work.encoder-profile-hints-api/1 : work {
    title "Expose render-neutral encoder profile hints"
    state completed
    scope [
        path "src/api.rs",
        path "src/encoder_hints.rs",
        path "src/main.rs",
        path "src/pipeline.rs",
        path "src/types.rs",
        path "tests/**",
        path "tools/**"
    ]
    intent """
        Define a versioned, serializable encoder-profile hints API derived from RAW analysis and semantic region evidence, independent of any encoder implementation. Hints must describe minimum bit depth, chroma fidelity, grain preservation, and optional spatial ROI inputs with explicit reasons/confidence, while never changing rendered pixels. Expose the result through the library API and JSON reports so future encoder work can live separately.
        """
    acceptance {
        check guardrails {
            statement """
                Unsupported face/person ROI signals and absent semantic evidence do not produce semantic ROI priority.
                """
            method command
            command "cargo test -q --lib encoder_hints"
            verified_by [ @raw-autotune.evidence.encoder-hints-api-tests/1 ]
        }
        check render-neutral {
            statement """
                Enabling semantic observation and deriving encoder hints does not change rendered pixels.
                """
            method command
            command "cargo test -q --all-targets"
            verified_by [ @raw-autotune.evidence.encoder-hints-render-neutral/1 ]
        }
        check report-plumbing {
            statement """
                Batch summaries and sidecars expose the same structured hint schema without embedding dense confidence buffers.
                """
            method command
            command "cargo test -q --lib encoder_profile"
            verified_by [ @raw-autotune.evidence.encoder-hints-real-frames/1 ]
        }
        check versioned-api {
            statement """
                A public versioned encoder-hints type is deterministic, serializable, and independently constructible from analysis and optional scene evidence.
                """
            method command
            command "cargo test -q --lib encoder_hints"
            verified_by [ @raw-autotune.evidence.encoder-hints-api-tests/1 ]
        }
    }
    depends_on [ @raw-autotune.work.scene-evidence-corpus-policy/2 ]
    derived_from [ @raw-autotune.assessment.scene-evidence-usefulness/2 ]
}

record raw-autotune.work.goal/1 : work {
    title "Goal"
    state proposed
    intent """
        Implement the testing apparatus from `docs/white-blowout-advice.md` (diagnostic dumps, clip-state map, synthetic constant-chromaticity ramps, ablation harness, new metrics) and then execute the advice's production fix sequence — continuous, neighbourhood-guided highlight chromaticity reconstruction with raw-domain clip confidence and perceptual gamut mapping — ending with a controlled local-tone evaluation. No HDR output work until the reconstruction and gamut defects are closed.
        """
    source {
        kind legacy
        path ".agents/plans/2026-08-07-white-blowout-testing-apparatus.md"
        excerpt """
            Implement the testing apparatus from `docs/white-blowout-advice.md` (diagnostic dumps, clip-state map, synthetic constant-chromaticity ramps, ablation harness, new metrics) and then execute the advice's production fix sequence — continuous, neighbourhood-guided highlight chromaticity reconstruction with raw-domain clip confidence and perceptual gamut mapping — ending with a controlled local-tone evaluation. No HDR output work until the reconstruction and gamut defects are closed.
            """
    }
}

record raw-autotune.work.harmonic-highlight-default-promotion/1 : work {
    title "Promote the accepted harmonic highlight path to the automatic profile"
    state completed
    scope [
        path "CHANGELOG.md",
        path "README.md",
        path "src/api.rs",
        path "src/cli.rs",
        path "src/highlight.rs",
        path "src/main.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/types.rs"
    ]
    intent """
        Promote the visually accepted harmonic highlight reconstruction with the conservative 75-88% inward area-support fade to the unattended CLI, interactive, batch-library, and in-memory API profile. Advance the profile identifier to archive-auto-v4 so it cannot be confused with the rejected, uncommitted archive-auto-v3 compression-ratio experiment.

        Use full reconstruction strength because spatial estimators require it. Preserve the current estimator as an explicit compatibility control, and keep highlight ratio exponent 0.6 and exact external lens profiles opt-in. Commit code, AKR, and generated documentation while excluding render corpora and developer artifacts.
        """
    acceptance {
        check accepted-output-reproduced {
            statement """
                An ordinary automatic render reproduces the accepted opt-in core-ramp-75-88 output byte-for-byte.
                """
            method command
            verified_by [
                @raw-autotune.evidence.harmonic-default-output-identity-20260810/1,
                @raw-autotune.evidence.harmonic-default-output-identity-committed-20260810/1
            ]
        }
        check automatic-profile-consistency {
            statement """
                The CLI, interactive path, public batch API, and in-memory API all select harmonic reconstruction at strength 1 under archive-auto-v4, while explicit current remains available.
                """
            method command
            verified_by [
                @raw-autotune.evidence.harmonic-default-profile-consistency-20260810/1,
                @raw-autotune.evidence.harmonic-default-profile-consistency-committed-20260810/1
            ]
        }
        check promotion-regression-gate {
            statement """
                Full tests, clippy, formatting, deterministic rendering, AKR build/check, and git diff checks pass before commit.
                """
            method command
            verified_by [
                @raw-autotune.evidence.harmonic-default-promotion-full-gate-20260810/1,
                @raw-autotune.evidence.harmonic-default-promotion-full-gate-committed-20260810/1
            ]
        }
    }
    author "GitHub Uploader"
}

record raw-autotune.work.harmonic-highlight-experiment/1 : work {
    title "Harmonic pre-demosaic highlight experiment"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "THIRD_PARTY.md",
        path "src/cli.rs",
        path "src/color.rs",
        path "src/memory.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs"
    ]
    intent """
        Add and validate an opt-in CLI-only clean-room harmonic highlight
        experiment on the normalized Bayer mosaic. Use connected clipped
        regions, local one/two-guide affine colour fits with quality gates,
        clipping-aware pyramid initialization, anisotropic obstacle-constrained
        transport, verified sensor-knee inversion, and a separate fully clipped
        luminance dome. Use pure-Rust faer f64 sparse Cholesky for bounded
        systems and deterministic projected relaxation for larger or failed
        systems. Keep measured sites and floors invariant and keep `current` as
        the unattended default. The work remains active pending real-frame
        corpus gates, measured 24 MP RSS, and further coloured-highlight
        abstention work.
        """
    depends_on [ @raw-autotune.work.slice-2-synthetic-ramp-suite-and-ablation/1 ]
}

record raw-autotune.work.harmonic-highlight-experiment/2 : work {
    title "Harmonic pre-demosaic highlight experiment"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "THIRD_PARTY.md",
        path "src/cli.rs",
        path "src/color.rs",
        path "src/memory.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs"
    ]
    intent """
        Add and validate an opt-in CLI-only clean-room harmonic highlight
        experiment on the normalized Bayer mosaic. Use connected clipped
        regions, local one/two-guide affine colour fits with quality gates,
        clipping-aware pyramid initialization, anisotropic obstacle-constrained
        transport, verified sensor-knee inversion, and a separate fully clipped
        luminance dome. Use pure-Rust faer f64 sparse Cholesky for bounded
        systems and deterministic projected relaxation for larger or failed
        systems. Keep measured sites and floors invariant and keep `current` as
        the unattended default.

        Coloured-highlight abstention now rejects non-identifiable collinear
        two-guide fits and applies a monotone soft leverage bound when a
        high-gain one-guide colour relation is extrapolated beyond three
        measured guide spans at a partially clipped site. The analytical
        blue-to-neutral sky peak ratio fell from 1.633 to 1.122 and normalized
        luminance RMSE from 0.219 to 0.064 without materially changing the
        constant-blue ramp or fully clipped dome. The work remains active
        pending real-frame corpus gates, measured 24 MP RSS, and reduction of
        residual false-colour and edge-energy error on spatially varying and
        deliberately independent-colour fixtures.
        """
    depends_on [ @raw-autotune.work.slice-2-synthetic-ramp-suite-and-ablation/1 ]
    supersedes [ @raw-autotune.work.harmonic-highlight-experiment/1 ]
}

record raw-autotune.work.harmonic-highlight-experiment/3 : work {
    title "Harmonic pre-demosaic highlight experiment"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "THIRD_PARTY.md",
        path "src/cli.rs",
        path "src/color.rs",
        path "src/memory.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs"
    ]
    intent """
        Add and validate an opt-in CLI-only clean-room harmonic highlight
        experiment on the normalized Bayer mosaic. Use connected clipped
        regions, local one/two-guide affine colour fits with quality gates,
        clipping-aware pyramid initialization, anisotropic obstacle-constrained
        transport, verified sensor-knee inversion, and a separate fully clipped
        luminance dome. Use pure-Rust faer f64 sparse Cholesky for bounded
        systems and deterministic projected relaxation for larger or failed
        systems. Keep measured sites and floors invariant and keep `current` as
        the unattended default.

        Coloured-highlight abstention rejects non-identifiable collinear
        two-guide fits and applies a monotone soft leverage bound when a
        high-gain one-guide colour relation is extrapolated beyond three
        measured guide spans at a partially clipped site. A white-balance-
        normalized convex envelope of chromaticities measured around each
        connected clipped region now limits unsupported partial-cell colour
        without changing measured channels, sensor lower bounds, supported
        constant-colour relationships, or fully clipped cores.

        The analytical constant-blue fixture remains unchanged. On the
        blue-to-neutral sky fixture the envelope reduces edge-energy ratio from
        1.638 to 0.893 and tone-boundary p99 from 0.0123 to 0.0082; normalized
        luminance RMSE remains inside its gate at 0.0818, while the residual
        false-colour fraction remains 0.3125. The complete 303-test unit suite
        and all integration, real-RAW, and profile tests pass.

        Three Sony ILCE-7C 24 MP frames rendered successfully at harmonic full
        strength with one concurrent image. The retained envelope run peaked at
        1,027,352 kB RSS and completed in 3:28.04. Human review preferred the
        harmonic renders overall but identified a localized magenta blowout in
        the right sky of `_DSC1290`. Timestamped before/after renders and stage
        dumps show that stronger boundary constraints do not materially remove
        the patch: it is already present after the spatial CFA path in an area
        dominated by two-channel clipping, while the later post-demosaic
        highlight stage adds essentially no hue delta. This pins the remaining
        defect to underdetermined chromaticity where sensor lower bounds prevent
        a raw-domain envelope from reaching the desired local sky hue.

        The work remains active. The next slice should transport measured
        boundary hue after demosaic while preserving the harmonic luminance
        field and should be gated against constant-blue, occluded-sky, coloured-
        highlight, and independent-channel fixtures before another real-frame
        corpus review. Wider real-frame gates and any memory-reserve adjustment
        also remain pending.
        """
    depends_on [ @raw-autotune.work.slice-2-synthetic-ramp-suite-and-ablation/1 ]
    supersedes [ @raw-autotune.work.harmonic-highlight-experiment/2 ]
}

record raw-autotune.work.harmonic-highlight-experiment/4 : work {
    title "Harmonic pre-demosaic highlight experiment"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "THIRD_PARTY.md",
        path "src/cli.rs",
        path "src/color.rs",
        path "src/highlight.rs",
        path "src/memory.rs",
        path "src/pipeline.rs",
        path "src/raw_highlight.rs",
        path "src/synthetic.rs"
    ]
    intent """
        Add and validate an opt-in CLI-only clean-room harmonic highlight
        experiment on the normalized Bayer mosaic. Use connected clipped
        regions, local one/two-guide affine colour fits with quality gates,
        clipping-aware pyramid initialization, anisotropic obstacle-constrained
        transport, verified sensor-knee inversion, and a separate fully clipped
        luminance dome. Use pure-Rust faer f64 sparse Cholesky for bounded
        systems and deterministic projected relaxation for larger or failed
        systems. Keep measured sites and floors invariant and keep `current` as
        the unattended default.

        Coloured-highlight abstention rejects non-identifiable collinear
        two-guide fits and applies a monotone soft leverage bound when a
        high-gain one-guide colour relation is extrapolated beyond three
        measured guide spans at a partially clipped site. A white-balance-
        normalized convex envelope of chromaticities measured around each
        connected clipped region limits unsupported partial-cell colour without
        changing measured channels, sensor lower bounds, supported constant-
        colour relationships, or fully clipped cores.

        The remaining broad magenta patch in `_DSC1290` is now addressed after
        demosaic, where the harmonic luminance field already exists. Harmonic
        alone builds a scale-bounded, edge-aware weighted-Laplacian field in CIE
        1976 u'v' from fully measured pixels through the one-channel-clipped
        fringe, and applies it only where two-channel clip confidence is locally
        area-filling. CIE Y is preserved exactly, single-channel coloured
        highlights and measured pixels remain bit-exact, invalid XYZ is excluded,
        and each chroma move is bounded to 0.04 u'v'. `current` and `raw-pyramid`
        retain their established output.

        The analytical constant-blue, neutral, correlated-detail, fully clipped,
        and sensor-knee fixtures remain unchanged at reported precision. The
        coloured-highlight fixture is exactly unchanged by post-demosaic
        transport. Independent-channel false colour is 0.43799 versus the prior
        0.43884. The occluded-sky hue error improves from 16.62 to 14.60 degrees,
        while false colour is effectively flat at 0.27051 versus 0.27014 and its
        hardest tone-boundary statistic remains a known regression to address.
        All 306 library tests and every API, metadata, real-RAW probe, lens-profile,
        and documentation test pass.

        Three Sony ILCE-7C 24 MP frames rendered successfully at harmonic full
        strength with one concurrent image in
        `output-tests/20260809-191941-p0800/harmonic-spatial-chroma/`. `_DSC1283`
        and `_DSC1289` remain visually stable. `_DSC1290` transports 387,688
        pixels and substantially reduces the broad right-side magenta fill to a
        pale blue/neutral highlight while preserving the harmonic luminance
        structure; thin pink contours remain around some occluder edges. The
        three-frame run peaked at 1,027,868 kB RSS.

        The work remains active. The next slice should remove the residual pink
        occluder contours while improving the occluded-sky tone-boundary metric,
        then widen the real-frame corpus gate and revisit memory reserve only if
        measured peaks require it.
        """
    depends_on [ @raw-autotune.work.slice-2-synthetic-ramp-suite-and-ablation/1 ]
    supersedes [ @raw-autotune.work.harmonic-highlight-experiment/3 ]
}

